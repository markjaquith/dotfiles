{
	"rules": [
		{
			"id": "@secretlint/secretlint-rule-preset-recommend"
		},
		{
			"id": "@secretlint/pattern",
			"options": {
				"patterns": [
					{
						"name": "a",
						"pattern": "/[A-F][za]n[ab]d[a-z]/"
					},
					{
						"name": "b",
						"pattern": "/c[oz]t[zi][ba]{3}/"
					},
					{
						"name": "gusto",
						"pattern": "/gusto/"
					},
					{
						"name": "payroll",
						"pattern": "/payroll-/"
					}
				]
			}
		}
	]
}
