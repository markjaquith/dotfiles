amends "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Config.pkl"

// Run a command silently, printing its combined output only on failure.
local function quietOnSuccess(cmd: String): String =
	"out=$( { \(cmd); } 2>&1) || { status=$?; printf '%s\\n' \"$out\" >&2; exit $status; }"

local linters = new Mapping<String, Step> {
	["oxfmt"] {
		glob = List("*.js", "*.jsx", "*.mjs", "*.cjs", "*.ts", "*.tsx", "*.mts", "*.cts", "*.css", "*.scss", "*.less", "*.html", "*.json", "*.json5", "*.jsonc", "*.yaml", "*.yml", "*.md", "*.graphql", "*.svelte", "*.astro", "*.vue")
		check = "oxfmt --check --no-error-on-unmatched-pattern {{ files }}"
		fix = "oxfmt --write --no-error-on-unmatched-pattern {{ files }}"
	}

	// Custom linter for pkl files
	["pkl"] {
		glob = "*.pkl"
		check = "pkl eval {{files}} >/dev/null"
	}

	["content-scan"] {
		check = "if [ -n \"{{files}}\" ]; then bunx secretlint {{files}}; fi"
	}

	["zsh-tests"] {
		check = quietOnSuccess("zsh test/url-chooser.test.zsh && zsh test/keychain-secret.test.zsh && zsh test/herdr-rename-tabs.test.zsh && zsh test/dotfiles-install.test.zsh")
	}

	// Slower Worktrunk integration tests, so only run when their inputs change.
	["wt-tests"] {
		glob = List("bin/wt-*", "test/wt-*")
		check = quietOnSuccess("for test_file in test/wt-*.test.zsh; do zsh \"$test_file\" || exit 1; done")
	}

	["agent-tests"] {
		check = quietOnSuccess("bun test test/agency-herdr-setup.test.ts test/agency-herdr-dispatch.test.ts test/agency-pi.test.ts")
	}

	["opencode-tests"] {
		check = quietOnSuccess("bunx tsc --noEmit -p home/.config/opencode/tsconfig.json && bun test ./home/.config/opencode/plugins/__tests__/*.test.ts test/herdr-opencode.test.ts test/opencode2-profile.test.ts test/opencode2-plugins.test.ts")
	}
}

hooks {
	["pre-commit"] {
		fix = true
		stash = "patch-file"
		steps = linters
	}

	["pre-push"] {
		fix = false
		steps = linters
	}

	["fix"] {
		fix = true
		steps = linters
	}

	["check"] {
		steps = linters
	}
}
