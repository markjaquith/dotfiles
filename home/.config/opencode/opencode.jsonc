{
	"$schema": "https://opencode.ai/config.json",
	// opencode-queue has no compatible beta19228 entrypoint (including 0.13.2).
	"plugin": ["@plannotator/opencode@0.27.12"],
	"snapshot": false,
	"mcp": {
		"playwright": {
			"type": "local",
			"command": ["npx", "-y", "@playwright/mcp@latest"],
			"enabled": true,
		},
	},
	"permission": {
		"read": {
			"~/.local/share/mise/installs/**": "allow",
		},
		"edit": {
			"~/worktrees/**": "allow",
		},
		"external_directory": {
			"~/.claude/plugins/**": "allow",
			"~/.plannotator/plans/**": "allow",
			"/Users/mark.jaquith/.crit/**": "allow",
			"/Users/mark/.crit/**": "allow",
			"~/worktrees/**": "allow",
		},
	},
}
