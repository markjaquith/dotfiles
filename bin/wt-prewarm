#!/usr/bin/env zsh

emulate -L zsh
setopt pipefail

# Maintain a pool of prewarmed worktrees so `wt new <branch>` and
# `wt try <branch>` can claim one instead of paying for a full checkout. The
# pool's existence is the opt-in signal: callers only take the fast path — and
# only ensure one remains afterward — when a ready member already exists. Arm
# it by running `wt prewarm` (alias for this script).

PREWARM_PREFIX="${WT_PREWARM_PREFIX:-worktree-prewarm-}"
LEGACY_PREWARM_BRANCH="worktrunk-prewarm"
MARKER=".wt-prewarm-ready"

function usage() {
	print -r -- "Usage: wt-prewarm [command] [options]"
	print -r -- ""
	print -r -- "Maintains a pool of prewarmed worktrees with prefix '${PREWARM_PREFIX}'."
	print -r -- ""
	print -r -- "Commands:"
	print -r -- "  ensure [--count N] [--refresh]"
	print -r -- "                    Ensure at least N ready prewarms (default: 1)"
	print -r -- "  remove            Remove all prewarm worktrees and branches"
	print -r -- "  status            Report prewarm state"
	print -r -- "  prepare [--create] [--base <base>] [--start-point <commit>]"
	print -r -- "          [--upstream <ref>] [--update] <branch>"
	print -r -- "                    Prepare a worktree, claiming a prewarm when possible"
	print -r -- "  update <branch>   Fast-forward <branch>'s worktree to the prewarm base"
	print -r -- "  help              Show this help"
}

function die() {
	print -u2 -- "wt-prewarm: $*"
	exit 1
}

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not inside a git repository"

function branch_exists() {
	git show-ref --verify --quiet "refs/heads/$1"
}

function is_prewarm_branch() {
	[[ "$1" == "${PREWARM_PREFIX}"[0-9a-f][0-9a-f][0-9a-f][0-9a-f] ]]
}

function prewarm_branches() {
	local branch

	git for-each-ref --format='%(refname:short)' refs/heads/ 2>/dev/null \
		| while IFS= read -r branch; do
			is_prewarm_branch "$branch" && print -r -- "$branch"
		done
}

function new_prewarm_branch() {
	local suffix branch candidate_path

	while true; do
		suffix=$(od -An -N2 -tx1 /dev/urandom 2>/dev/null | tr -d '[:space:]')
		[[ "$suffix" == [0-9a-f][0-9a-f][0-9a-f][0-9a-f] ]] || return 1
		branch="${PREWARM_PREFIX}${suffix}"
		candidate_path=$(prewarm_worktree_path "$branch") || return 1
		if ! branch_exists "$branch" && [[ ! -e "$candidate_path" ]]; then
			print -r -- "$branch"
			return 0
		fi
	done
}

function worktree_path_for_branch() {
	local target_branch="$1"
	local worktree_path

	git worktree list --porcelain | while IFS= read -r line; do
		if [[ "$line" == worktree\ * ]]; then
			worktree_path="${line#worktree }"
			continue
		fi

		if [[ "$line" == "branch refs/heads/${target_branch}" ]]; then
			print -r -- "$worktree_path"
			return 0
		fi
	done
}

function default_branch() {
	local d c

	if d=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); then
		print -r -- "${d#origin/}"
		return 0
	fi

	for c in main master; do
		if branch_exists "$c"; then
			print -r -- "$c"
			return 0
		fi
	done

	git rev-parse --abbrev-ref HEAD
}

function lock_path() {
	local gcd
	gcd=$(git rev-parse --git-common-dir 2>/dev/null) || return 1
	[[ "$gcd" == /* ]] || gcd="${PWD}/${gcd}"
	print -r -- "${gcd%/}/wt-prewarm.lock"
}

function member_lock_path() {
	local gcd branch_sanitized

	gcd=$(git rev-parse --git-common-dir 2>/dev/null) || return 1
	[[ "$gcd" == /* ]] || gcd="${PWD}/${gcd}"
	branch_sanitized="${1//[\/\\]/-}"
	print -r -- "${gcd%/}/wt-prewarm.${branch_sanitized}.lock"
}

function acquire_lock() {
	local lock="$1"
	local mt now

	if mkdir "$lock" 2>/dev/null; then
		return 0
	fi

	# Stale-lock breaker: reclaim a lock older than 5 minutes.
	mt=$(stat -f %m "$lock" 2>/dev/null) || mt=$(stat -c %Y "$lock" 2>/dev/null)
	now=$(date +%s)
	if [[ -n "$mt" ]] && (( now - mt > 300 )); then
		rmdir "$lock" 2>/dev/null
		mkdir "$lock" 2>/dev/null && return 0
	fi

	return 1
}

function release_lock() {
	[[ -n "$1" ]] && rmdir "$1" 2>/dev/null
	return 0
}

function acquire_lock_wait() {
	local lock="$1"

	until acquire_lock "$lock"; do
		sleep 0.1
	done
}

# This script runs inside a Worktrunk alias, so it inherits the interactive
# shell's directive files. Only the caller's final `wt switch` should write to
# them; internal and background calls must never redirect the parent shell.
function wt_internal() {
	(
		unset WORKTRUNK_DIRECTIVE_CD_FILE
		unset WORKTRUNK_DIRECTIVE_EXEC_FILE
		unset WORKTRUNK_DIRECTIVE_FILE
		command wt "$@"
	)
}

# Resolve the configured Worktrunk path for the prewarm branch. The supported
# variables cover this machine's central worktree layout and Worktrunk's default.
function prewarm_worktree_path() {
	local prewarm_branch="$1"
	local config_json identifier template repo_path repo branch_sanitized rendered

	command -v jq >/dev/null 2>&1 || return 1
	config_json=$(wt_internal config show --format=json 2>/dev/null) || return 1
	identifier=$(print -r -- "$config_json" | jq -r '.project.identifier // ""') || return 1
	template=$(print -r -- "$config_json" | jq -r --arg identifier "$identifier" \
		'.user.config.projects[$identifier]["worktree-path"] //
		 .user.config["worktree-path"] //
		 "{{ repo_path }}/../{{ repo }}.{{ branch | sanitize }}"') || return 1

	repo_path=$(git worktree list --porcelain | sed -n 's/^worktree //p' | head -1)
	[[ -n "$repo_path" ]] || return 1
	repo="${repo_path:t}"
	branch_sanitized="${prewarm_branch//[\/\\]/-}"
	rendered=$(jq -nr \
		--arg template "$template" \
		--arg repo_path "$repo_path" \
		--arg repo "$repo" \
		--arg branch "$prewarm_branch" \
		--arg branch_sanitized "$branch_sanitized" \
		'$template
		| gsub("\\{\\{ repo_path \\}\\}"; $repo_path)
		| gsub("\\{\\{ repo \\}\\}"; $repo)
		| gsub("\\{\\{ branch \\}\\}"; $branch)
		| gsub("\\{\\{ branch \\| sanitize \\}\\}"; $branch_sanitized)') || return 1
	[[ "$rendered" != *'{{'* ]] || return 1

	[[ "$rendered" == '~/'* ]] && rendered="${HOME}/${rendered#\~/}"
	[[ "$rendered" == /* ]] || rendered="${repo_path}/${rendered}"
	print -r -- "${rendered:A}"
}

function remove_prewarm() {
	local prewarm_branch="$1"
	local pw

	pw=$(worktree_path_for_branch "$prewarm_branch" 2>/dev/null)
	[[ -n "$pw" ]] || branch_exists "$prewarm_branch" || return 0

	wt_internal -y remove --foreground --force --force-delete --no-hooks \
		"$prewarm_branch"
}

function build_prewarm() {
	local prewarm_branch="$1"
	local base pw

	base=$(default_branch) || return 1

	command -v cowtree >/dev/null 2>&1 \
		|| die "cowtree is required; run dotfiles-install"
	pw=$(prewarm_worktree_path "$prewarm_branch") \
		|| die "could not resolve the configured Worktrunk prewarm path"
	mkdir -p "${pw:h}" || return 1

	# The prewarm is intentionally created without Worktrunk hooks. Hooks must
	# run against the claiming branch at its final path, not against the prewarm
	# branch at this temporary path.
	cowtree add -b "$prewarm_branch" "$pw" "$base" || return 1

	pw=$(worktree_path_for_branch "$prewarm_branch" 2>/dev/null)
	[[ -n "$pw" ]] || return 1

	# The marker means the expensive checkout is complete. Because the build runs
	# no hooks, there is no background install that a claim could move out from
	# under, so marker-present truly means claimable.
	touch "${pw}/${MARKER}"
	print -r -- "wt-prewarm: ready at ${pw} (branch ${prewarm_branch}, base ${base})"
}

function remove_all_prewarms() {
	local include_legacy="${1:-0}"
	local branch member_lock
	local -a branches

	branches=("${(@f)$(prewarm_branches)}")
	if (( include_legacy )) && branch_exists "$LEGACY_PREWARM_BRANCH"; then
		branches+=("$LEGACY_PREWARM_BRANCH")
	fi

	for branch in "${branches[@]}"; do
		[[ -n "$branch" ]] || continue
		member_lock=$(member_lock_path "$branch") || return 1
		acquire_lock_wait "$member_lock" || return 1
		if ! remove_prewarm "$branch"; then
			release_lock "$member_lock"
			return 1
		fi
		release_lock "$member_lock"
	done
}

function ready_prewarm_count() {
	local branch pw count=0

	for branch in "${(@f)$(prewarm_branches)}"; do
		[[ -n "$branch" ]] || continue
		pw=$(worktree_path_for_branch "$branch" 2>/dev/null)
		[[ -n "$pw" && -d "$pw" && -f "${pw}/${MARKER}" ]] && (( count++ ))
	done

	print -r -- "$count"
}

# Claim the prewarmed worktree instead of paying for a full checkout. Returns 0
# on success (worktree now exists on "$branch_name"), non-zero to signal the
# caller should fall back to the slow path. A start point lets callers such as
# `wt try` reuse the checkout for an existing remote branch; without one, the
# branch remains at the prewarm's default-branch commit for `wt new`. Any failure
# rolls back to a clean prewarm before returning non-zero.
function claim_prewarm() {
	local branch_name="$1"
	local start_point="$2"
	local upstream="$3"
	local prewarm_branch candidate_path candidate_lock
	local pw_path parent pw_base prewarm_sanitized branch_sanitized target_path lock
	local prewarm_head target_commit

	[[ -n "$branch_name" ]] || die "claim requires a branch name"

	# The destination branch must not already exist. Cheap single git show-ref
	# gate, kept before the lock so an obviously-doomed claim never contends.
	branch_exists "$branch_name" && return 1

	# Scan ready pool members and atomically reserve the first available one.
	# Locks are per member, so independent claims can proceed concurrently.
	for prewarm_branch in "${(@f)$(prewarm_branches)}"; do
		[[ -n "$prewarm_branch" ]] || continue
		candidate_path=$(worktree_path_for_branch "$prewarm_branch" 2>/dev/null)
		[[ -n "$candidate_path" && -d "$candidate_path" \
			&& -f "${candidate_path}/${MARKER}" ]] || continue
		candidate_lock=$(member_lock_path "$prewarm_branch") || continue
		if acquire_lock "$candidate_lock"; then
			pw_path="$candidate_path"
			lock="$candidate_lock"
			break
		fi
	done

	[[ -n "$pw_path" ]] || return 1
	if ! branch_exists "$prewarm_branch" || [[ ! -d "$pw_path" || ! -f "${pw_path}/${MARKER}" ]]; then
		release_lock "$lock"
		return 1
	fi

	# The normal path is a sibling of the prewarm using the sanitized branch name.
	# Callers such as `wt new --worktree-path` may supply an exact destination.
	parent="${pw_path:h}"
	pw_base="${pw_path:t}"
	prewarm_sanitized="${prewarm_branch//[\/\\]/-}"
	branch_sanitized="${branch_name//[\/\\]/-}"
	if [[ -n "${WT_NEW_WORKTREE_PATH:-}" ]]; then
		target_path="$WT_NEW_WORKTREE_PATH"
	else
		target_path="${parent}/${branch_sanitized}"
	fi
	if [[ "$pw_base" != "$prewarm_sanitized" || -e "$target_path" ]]; then
		release_lock "$lock"
		return 1
	fi
	mkdir -p "${target_path:h}" || {
		release_lock "$lock"
		return 1
	}

	# Drop the readiness marker so it does not travel into the new worktree.
	rm -f "${pw_path}/${MARKER}" 2>/dev/null
	prewarm_head=$(git rev-parse --verify "${prewarm_branch}^{commit}" 2>/dev/null)
	if [[ -z "$prewarm_head" ]]; then
		touch "${pw_path}/${MARKER}" 2>/dev/null
		release_lock "$lock"
		return 1
	fi

	# A fetched branch can reuse the prewarm checkout by updating only the files
	# that differ from the default branch. Do this before the rename and hooks so
	# every lifecycle hook observes the requested commit at the final path.
	if [[ -n "$start_point" ]]; then
		target_commit=$(git rev-parse --verify "${start_point}^{commit}" 2>/dev/null)
		if [[ -z "$target_commit" ]] || ! git -C "$pw_path" reset --hard "$target_commit" >/dev/null 2>&1; then
			git -C "$pw_path" reset --hard "$prewarm_head" >/dev/null 2>&1
			touch "${pw_path}/${MARKER}" 2>/dev/null
			release_lock "$lock"
			return 1
		fi
	fi

	# Rename the branch in place (instant).
	if ! git branch -m "$prewarm_branch" "$branch_name" 2>/dev/null; then
		git -C "$pw_path" reset --hard "$prewarm_head" >/dev/null 2>&1
		touch "${pw_path}/${MARKER}" 2>/dev/null
		release_lock "$lock"
		return 1
	fi

	# Move the worktree directory to its template path (same-filesystem rename).
	if ! git worktree move "$pw_path" "$target_path" 2>/dev/null; then
		# Roll back the rename; the worktree is still at pw_path on branch_name.
		if git branch -m "$branch_name" "$prewarm_branch" 2>/dev/null; then
			git -C "$pw_path" reset --hard "$prewarm_head" >/dev/null 2>&1
			touch "${pw_path}/${MARKER}" 2>/dev/null
		fi
		release_lock "$lock"
		return 1
	fi

	if [[ -n "$upstream" ]]; then
		git -C "$target_path" branch --set-upstream-to="$upstream" "$branch_name" >/dev/null 2>&1 \
			|| print -u2 -- "wt-prewarm: could not set ${branch_name} to track ${upstream} (continuing)"
	fi

	release_lock "$lock"

	# The claim bypassed the normal Worktrunk switch/create path, so none of its
	# hooks have run for "$branch_name". Run them now against the
	# claimed worktree at its final path so behavior matches the slow path
	# (`wt switch --create`). These must target the real branch/path — the
	# prewarm build runs with --no-hooks precisely so path-keyed and
	# branch-derived hooks resolve here, not against the prewarm branch.
	# Best-effort: the worktree already exists, so a hook failure must not fail
	# the claim.
	#
	# Each `wt hook` invocation costs ~1.25s of worktrunk startup, and worktrunk
	# already self-backgrounds the actual install work. Only pre-start
	# (e.g. mise trust) is a documented "blocks" hook, so it stays synchronous;
	# the post-switch/post-start phases are detached into a single background
	# subshell (run sequentially there so post-start still follows post-switch)
	# so the claim message prints ~2.5s sooner. The caller's final `wt switch`
	# re-runs post-switch idempotently, so a slight overlap here is harmless.
	wt_internal -C "$target_path" -y hook pre-start </dev/null >/dev/null 2>&1 \
		|| print -u2 -- "wt-prewarm: pre-start hooks failed for ${branch_name} (continuing)"

	(
		wt_internal -C "$target_path" -y hook post-switch </dev/null >/dev/null 2>&1
		wt_internal -C "$target_path" -y hook post-start </dev/null >/dev/null 2>&1
	) &
	disown 2>/dev/null

	# Re-arm the prewarm in the background. `ensure` waits behind any concurrent
	# checkout and avoids rebuilding if another claim already restored it.
	(
		unset WORKTRUNK_DIRECTIVE_CD_FILE
		unset WORKTRUNK_DIRECTIVE_EXEC_FILE
		unset WORKTRUNK_DIRECTIVE_FILE
		unset WT_NEW_WORKTREE_PATH
		if [[ -n "${WT_NEW_SOURCE_CONFIG:-}" ]]; then
			export WORKTRUNK_CONFIG_PATH="$WT_NEW_SOURCE_CONFIG"
		fi
		unset WT_NEW_SOURCE_CONFIG
		wt-prewarm ensure </dev/null >/dev/null 2>&1
	) &
	disown 2>/dev/null

	print -u2 -- "wt-prewarm: claimed prewarm → ${branch_name}"
	return 0
}

# Prepare a worktree, using a ready prewarm when its inputs make that safe.
# --create prepares a new branch for `wt new`; without it, an existing fetched
# branch is prepared for `wt try`. The slow path delegates to `wt switch` so
# normal Worktrunk creation behavior remains the source of truth.
function prepare_worktree() {
	local create_branch=0
	local update_after_create=0
	local base_branch=""
	local start_point=""
	local upstream=""
	local branch_name
	local claimed=0
	local default_base lock rc
	local -a switch_args

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--create)
				create_branch=1
				shift
				;;
			--base)
				shift
				[[ -n "$1" ]] || die "prepare --base requires a branch"
				base_branch="$1"
				shift
				;;
			--start-point)
				shift
				[[ -n "$1" ]] || die "prepare --start-point requires a commit"
				start_point="$1"
				shift
				;;
			--upstream)
				shift
				[[ -n "$1" ]] || die "prepare --upstream requires a ref"
				upstream="$1"
				shift
				;;
			--update)
				update_after_create=1
				shift
				;;
			--)
				shift
				break
				;;
			-*)
				die "unknown prepare option: $1"
				;;
			*)
				break
				;;
		esac
	done

	[[ $# -eq 1 ]] || die "prepare requires exactly one branch"
	branch_name="$1"

	if (( create_branch )); then
		[[ -z "$start_point" && -z "$upstream" ]] \
			|| die "prepare --create cannot use --start-point or --upstream"
	else
		[[ -z "$base_branch" && "$update_after_create" -eq 0 ]] \
			|| die "prepare requires --create with --base or --update"
		[[ -z "$upstream" || -n "$start_point" ]] \
			|| die "prepare --upstream requires --start-point"
	fi

	if (( create_branch )) && [[ -z "$base_branch" ]]; then
		claim_prewarm "$branch_name" && claimed=1
	elif (( create_branch )); then
		default_base=$(default_branch)
		if [[ "$base_branch" == "$default_base" ]]; then
			claim_prewarm "$branch_name" "$base_branch" && claimed=1
		fi
	elif (( ! create_branch )) && [[ -n "$start_point" ]]; then
		claim_prewarm "$branch_name" "$start_point" "$upstream" && claimed=1
	fi

	if (( ! claimed )); then
		switch_args=(switch --no-cd)
		if (( create_branch )); then
			switch_args+=(--create)
		fi
		if [[ -n "$base_branch" ]]; then
			switch_args+=(--base "$base_branch")
		fi
		switch_args+=("$branch_name")

		# `git worktree add` runs repository post-checkout hooks. Serialize it
		# with other slow-path creates and prewarm builds: hooks that stop shared
		# processes are often individually idempotent but not concurrency-safe.
		lock=$(lock_path) || return 1
		acquire_lock_wait "$lock" || return 1
		wt_internal "${switch_args[@]}"
		rc=$?
		release_lock "$lock"
		(( rc == 0 )) || return $rc
	fi

	if (( update_after_create )) && [[ -z "$base_branch" ]]; then
		update_branch "$branch_name"
	fi
}

# Bring <branch>'s worktree up to speed with the LOCAL tip of the prewarm base
# branch (the same default branch the prewarm was built from). There is no
# fetch — the caller owns remote freshness. This is best-effort: a fast-forward
# keeps history clean and only succeeds when <branch> hasn't diverged from the
# base (the expected case for a freshly created or just-claimed prewarm branch).
# If it cannot fast-forward, report it and still return 0 so `wt new` continues;
# the branch is simply left at its current (older) tip and the user is told.
function update_branch() {
	local branch_name="$1"
	local base wt_path

	[[ -n "$branch_name" ]] || die "update requires a branch name"

	base=$(default_branch) || return 0

	# Nothing to integrate if the branch is the base branch itself.
	[[ "$base" == "$branch_name" ]] && return 0

	wt_path=$(worktree_path_for_branch "$branch_name" 2>/dev/null)
	if [[ -z "$wt_path" || ! -d "$wt_path" ]]; then
		print -u2 -- "wt-prewarm: no worktree found for ${branch_name}; skipping update"
		return 0
	fi

	if git -C "$wt_path" merge --ff-only "$base" >/dev/null 2>&1; then
		print -u2 -- "wt-prewarm: ${branch_name} is up to date with ${base}"
		return 0
	fi

	print -u2 -- "wt-prewarm: could not fast-forward ${branch_name} to ${base}; leaving it as-is (not up to date with ${base})"
	return 0
}

function ensure_pool() {
	local count=1
	local refresh=0
	local existing_count target ready branch pw new_branch
	local lock rc=0
	local -a existing

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--count)
				shift
				[[ -n "${1:-}" ]] || die "ensure --count requires a number"
				count="$1"
				shift
				;;
			--refresh)
				refresh=1
				shift
				;;
			-*)
				die "unknown ensure option: $1"
				;;
			*)
				die "ensure does not accept arguments"
				;;
		esac
	done

	[[ "$count" == <-> ]] && (( count >= 1 )) \
		|| die "ensure --count must be a positive integer"

	lock=$(lock_path) || die "could not resolve lock path"
	acquire_lock_wait "$lock" || return 1

	# The old singleton is not a pool member. Clean it up automatically during
	# migration so it cannot leave a hidden worktree behind.
	if branch_exists "$LEGACY_PREWARM_BRANCH"; then
		remove_prewarm "$LEGACY_PREWARM_BRANCH" || rc=$?
	fi

	existing=("${(@f)$(prewarm_branches)}")
	existing_count=0
	for branch in "${existing[@]}"; do
		[[ -n "$branch" ]] && (( existing_count++ ))
	done
	target=$count
	(( refresh && existing_count > target )) && target=$existing_count

	if (( rc == 0 && refresh )); then
		remove_all_prewarms || rc=$?
	elif (( rc == 0 )); then
		# An unmarked member is incomplete and cannot be claimed. Remove it so the
		# top-up below replaces it rather than accumulating broken pool members.
		for branch in "${existing[@]}"; do
			[[ -n "$branch" ]] || continue
			pw=$(worktree_path_for_branch "$branch" 2>/dev/null)
			if [[ -z "$pw" || ! -d "$pw" || ! -f "${pw}/${MARKER}" ]]; then
				remove_prewarm "$branch" || {
					rc=$?
					break
				}
			fi
		done
	fi

	while (( rc == 0 )); do
		ready=$(ready_prewarm_count) || {
			rc=$?
			break
		}
		(( ready >= target )) && break
		new_branch=$(new_prewarm_branch) || {
			rc=$?
			break
		}
		build_prewarm "$new_branch" || rc=$?
	done

	release_lock "$lock"
	(( rc == 0 )) || return $rc
	print -r -- "wt-prewarm: ${ready} ready (minimum ${target})"
}

command_name="${1:-ensure}"
if [[ $# -gt 0 ]]; then
	shift
fi

case "$command_name" in
	-h|--help|help)
		usage
		exit 0
		;;
	status)
		[[ $# -eq 0 ]] || die "status does not accept arguments"
		ready=0
		building=0
		status_lines=()
		for branch in "${(@f)$(prewarm_branches)}"; do
			[[ -n "$branch" ]] || continue
			pw=$(worktree_path_for_branch "$branch" 2>/dev/null)
			if [[ -n "$pw" && -d "$pw" && -f "${pw}/${MARKER}" ]]; then
				(( ready++ ))
				status_lines+=("ready: ${branch} ${pw}")
			else
				(( building++ ))
				status_lines+=("building: ${branch} ${pw:-no worktree}")
			fi
		done
		print -r -- "ready: ${ready}, building: ${building}, total: $(( ready + building ))"
		for line in "${status_lines[@]}"; do
			print -r -- "$line"
		done
		exit 0
		;;
	remove)
		[[ $# -eq 0 ]] || die "remove does not accept arguments"
		lock=$(lock_path) || die "could not resolve lock path"
		acquire_lock "$lock" || die "another wt-prewarm operation is in progress"
		remove_all_prewarms 1
		rc=$?
		release_lock "$lock"
		(( rc == 0 )) && print -r -- "wt-prewarm: removed all"
		exit $rc
		;;
	prepare)
		prepare_worktree "$@"
		exit $?
		;;
	update)
		[[ $# -eq 1 ]] || die "update requires exactly one branch"
		update_branch "$1"
		exit $?
		;;
	ensure)
		ensure_pool "$@"
		exit $?
		;;
	*)
		usage
		exit 1
		;;
esac
