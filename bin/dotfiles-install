#!/usr/bin/env zsh
# vim: ft=zsh

# Top-level driver for dotfiles installation
SCRIPT_DIR="$(cd "$(dirname "${0}")" && pwd)"
SCRIPT_NAME="${0:t}"

print_help() {
	cat <<EOF
Usage: ${SCRIPT_NAME} [option]

Install and configure this dotfiles environment.

This runs the full installation flow:
  - install prerequisites and package-manager dependencies
  - install Homebrew, Bun, pip, mise, Rust, and manual tools
  - configure fonts, app/tool settings, and git hooks
  - run ~/.local-dotfiles/bin/dotfiles-install-local when present

Options:
  -h, --help    Show this help message and exit.

No other options are currently supported.
EOF
}

if (( $# > 0 )); then
	case "$1" in
		-h|--help)
			print_help
			exit 0
			;;
		*)
			print -u2 "Unknown option: $1"
			print -u2 "Run '${SCRIPT_NAME} --help' for usage."
			exit 64
			;;
	esac
fi

# Also report explicit exits from a sourced installer, which bypass ZERR.
trap '
	install_status=$?
	if (( install_status )); then
		print -u2 -- "dotfiles-install: installation failed (exit ${install_status})"
	fi
' EXIT

run_stage() {
	setopt localoptions localtraps errexit pipefail
	local stage_name=$1
	shift
	# Preserve a diagnostic stream even when the failing command hides stderr.
	trap '
		stage_status=$?
		print -u3 -- "dotfiles-install: ${stage_name} failed (exit ${stage_status})"
		exit "$stage_status"
	' ZERR
	"$@"
} 3>&2

# Call stages unconditionally: an if/|| around a sourced function disables
# errexit inside it, allowing a later successful command to mask a failure.
# Prerequisites stay in this shell to retain their variables and exports.
run_stage prereqs source "${SCRIPT_DIR}/dotfiles-install-prereqs.zsh"

(run_stage brew source "${SCRIPT_DIR}/dotfiles-install-brew.zsh") &
brew_pid=$!
(run_stage bun source "${SCRIPT_DIR}/dotfiles-install-bun.zsh") &
bun_pid=$!
wait "$brew_pid"
brew_status=$?
wait "$bun_pid"
bun_status=$?
if (( brew_status || bun_status )); then
	print -u2 -- "dotfiles-install: package stages failed (brew=${brew_status}, bun=${bun_status}); stopping"
	exit 1
fi

(run_stage pip source "${SCRIPT_DIR}/dotfiles-install-pip.zsh")
pip_status=$?
(( pip_status == 0 )) || exit "$pip_status"

(run_stage mise source "${SCRIPT_DIR}/dotfiles-install-mise.zsh") &
mise_pid=$!
(run_stage tools source "${SCRIPT_DIR}/dotfiles-install-tools.zsh")
tools_status=$?
# Always reap mise, even when tools failed, before exiting or using its tools.
wait "$mise_pid"
mise_status=$?
if (( mise_status || tools_status )); then
	print -u2 -- "dotfiles-install: tool stages failed (mise=${mise_status}, tools=${tools_status}); stopping"
	exit 1
fi

(run_stage configs source "${SCRIPT_DIR}/dotfiles-install-configs.zsh")
configs_status=$?
(( configs_status == 0 )) || exit "$configs_status"

(run_stage crontab-sync "${SCRIPT_DIR}/crontab-sync" apply)
crontab_status=$?
(( crontab_status == 0 )) || exit "$crontab_status"
(run_stage fonts source "${SCRIPT_DIR}/dotfiles-install-fonts.zsh")
fonts_status=$?
(( fonts_status == 0 )) || exit "$fonts_status"

# Run custom local dotfiles-install if available. Keep its name distinct from
# this driver so a higher-priority local bin directory cannot shadow the driver.
if [[ -f "${HOME}/.local-dotfiles/bin/dotfiles-install-local" ]]; then
	# Source in this shell so local PATH, functions, and exports still reach
	# the dependency and hook installs below, without leaking strict options.
	run_stage local source "${HOME}/.local-dotfiles/bin/dotfiles-install-local"
fi
(
	install_dependencies() {
		cd "${SCRIPT_DIR}/.."
		bun i
	}
	run_stage dependencies install_dependencies
)
dependencies_status=$?
(( dependencies_status == 0 )) || exit "$dependencies_status"

(run_stage git-hooks source "${SCRIPT_DIR}/dotfiles-install-git-hooks.zsh")
hooks_status=$?
(( hooks_status == 0 )) || exit "$hooks_status"

echo "\033[32m✔\033[0m  Done!"
