#!/usr/bin/env zsh

emulate -L zsh
setopt pipefail

readonly BEGIN_MARKER="# BEGIN crontab-sync managed section"
readonly END_MARKER="# END crontab-sync managed section"
readonly GENERATED_WARNING="# Generated by crontab-sync. Edit the JSON source, not this section."
readonly DEFAULT_CONFIG="$HOME/.config/crontab/jobs.json"

typeset COMMAND=""
typeset CONFIG_FILE="$DEFAULT_CONFIG"

fail() {
	print -u2 -- "crontab-sync: $*"
	return 1
}

print_help() {
	cat <<EOF
Usage: crontab-sync <check|render|diff|apply> [-f FILE]

Manage a fenced section of the current user's crontab from JSON.

Commands:
  check    Validate the JSON source
  render   Print the generated managed section
  diff     Show the changes that apply would make
  apply    Replace the managed section in the current crontab

Options:
  -f, --file FILE  JSON source (default: $DEFAULT_CONFIG)
  -h, --help       Show this help
EOF
}

parse_args() {
	if (( $# == 0 )); then
		print_help >&2
		return 2
	fi

	COMMAND=$1
	shift
	case "$COMMAND" in
		check|render|diff|apply) ;;
		-h|--help)
			print_help
			exit 0
			;;
		*)
			fail "unknown command: $COMMAND"
			return 2
			;;
	esac

	while (( $# > 0 )); do
		case "$1" in
			-f|--file)
				if (( $# < 2 )); then
					fail "$1 requires a file"
					return 2
				fi
				CONFIG_FILE=$2
				if [[ "$CONFIG_FILE" == "~/"* ]]; then
					CONFIG_FILE="$HOME/${CONFIG_FILE#\~/}"
				fi
				shift 2
				;;
			-h|--help)
				print_help
				exit 0
				;;
			*)
				fail "unknown option: $1"
				return 2
				;;
		esac
	done
}

validate_config() {
	local config_file=$1

	if [[ ! -f "$config_file" ]]; then
		fail "config file does not exist: $config_file"
		return 1
	fi

	if ! command -v jq >/dev/null 2>&1; then
		fail "jq is required"
		return 1
	fi

	local message
	if ! message=$(jq -e '
		def invalid($message): error($message);
		def single_line: type == "string" and length > 0 and (test("[\\r\\n]") | not);
		def valid_schedule:
			test("^\\s*\\S+(\\s+\\S+){4}\\s*$") or
			. == "@annually" or . == "@yearly" or . == "@monthly" or
			. == "@weekly" or . == "@daily" or . == "@midnight" or
			. == "@hourly" or . == "@reboot";
		def validate_job($index):
			. as $job |
			if type != "object" then invalid("jobs[\($index)] must be an object")
			elif ((keys - ["command", "description", "enabled", "name", "schedule"]) | length) > 0
			then invalid("jobs[\($index)] has unknown keys")
			elif (.name | single_line) | not then invalid("jobs[\($index)].name must be a non-empty single-line string")
			elif (.schedule | single_line) | not then invalid("jobs[\($index)].schedule must be a non-empty single-line string")
			elif (.command | single_line) | not then invalid("jobs[\($index)].command must be a non-empty single-line string")
			elif (has("description") and (.description | type != "string" or test("[\\r\\n]"))) then invalid("jobs[\($index)].description must be a single-line string")
			elif (has("enabled") and (.enabled | type != "boolean")) then invalid("jobs[\($index)].enabled must be a boolean")
			elif (.schedule | valid_schedule) | not then invalid("jobs[\($index)].schedule must contain five cron fields or a supported macro")
			else $job end;
		if type != "object" or keys != ["jobs"] then invalid("config must be an object containing only a jobs array")
		elif (.jobs | type) != "array" then invalid("jobs must be an array")
		else
			[.jobs | to_entries[] | . as $entry | $entry.value | validate_job($entry.key)] as $jobs |
			if ([$jobs | group_by(.name)[] | select(length > 1)] | length) > 0
			then invalid("job names must be unique")
			else true end
		end
	' "$config_file" 2>&1); then
		fail "invalid config: $message"
		return 1
	fi
}

render_managed_section() {
	local config_file=$1

	print -r -- "$BEGIN_MARKER"
	print -r -- "$GENERATED_WARNING"
	jq -r '
		.jobs[] |
		"",
		"# \(.name)",
		(if has("description") and .description != "" then "# \(.description)" else empty end),
		(if .enabled == false
		 then "# DISABLED: \(.schedule) \(.command)"
		 else "\(.schedule) \(.command)"
		 end)
	' "$config_file"
	print
	print -r -- "$END_MARKER"
}

replace_managed_section() {
	local current_file=$1
	local managed_file=$2
	local output_file=$3
	local begin_count end_count

	begin_count=$(grep -Fxc -- "$BEGIN_MARKER" "$current_file" || true)
	end_count=$(grep -Fxc -- "$END_MARKER" "$current_file" || true)

	if (( begin_count == 0 && end_count == 0 )); then
		cat "$current_file" >| "$output_file"
		if [[ -s "$current_file" ]]; then
			if ! tail -c 1 "$current_file" | grep -q '^$'; then
				print >> "$output_file"
			fi
			print >> "$output_file"
		fi
		cat "$managed_file" >> "$output_file"
		return 0
	fi

	if (( begin_count != 1 || end_count != 1 )); then
		fail "existing crontab must contain exactly one complete managed section"
		return 1
	fi

	awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" -v managed="$managed_file" '
		$0 == begin {
			while ((getline line < managed) > 0) print line
			close(managed)
			skipping = 1
			next
		}
		$0 == end {
			if (!skipping) exit 42
			skipping = 0
			next
		}
		!skipping { print }
		END { if (skipping) exit 43 }
	' "$current_file" >| "$output_file"
	local awk_status=$?
	if (( awk_status != 0 )); then
		fail "managed section end marker appears before begin marker"
		return 1
	fi
}

read_crontab() {
	local output_file=$1
	local error_file=$2

	if crontab -l >| "$output_file" 2>| "$error_file"; then
		return 0
	fi
	if grep -qi "no crontab" "$error_file"; then
		: >| "$output_file"
		return 0
	fi
	fail "could not read crontab: $(<"$error_file")"
}

main() {
	parse_args "$@" || return $?
	validate_config "$CONFIG_FILE" || return 1

	local job_count
	job_count=$(jq '.jobs | length' "$CONFIG_FILE")

	if [[ "$COMMAND" == check ]]; then
		print -- "Valid: $job_count job(s)"
		return 0
	fi

	local temp_dir
	temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/crontab-sync.XXXXXX") || return 1
	trap "rm -rf ${(q)temp_dir}" EXIT INT TERM

	local managed_file="$temp_dir/managed"
	render_managed_section "$CONFIG_FILE" >| "$managed_file"

	if [[ "$COMMAND" == render ]]; then
		cat "$managed_file"
		return 0
	fi

	local current_file="$temp_dir/current"
	local error_file="$temp_dir/error"
	local updated_file="$temp_dir/updated"
	read_crontab "$current_file" "$error_file" || return 1
	replace_managed_section "$current_file" "$managed_file" "$updated_file" || return 1

	if [[ "$COMMAND" == diff ]]; then
		diff -u "$current_file" "$updated_file" || [[ $? == 1 ]]
		return $?
	fi

	if cmp -s "$current_file" "$updated_file"; then
		print "Crontab already up to date"
		return 0
	fi

	if ! crontab - < "$updated_file" 2>| "$error_file"; then
		fail "could not install crontab: $(<"$error_file")"
		return 1
	fi
	print -- "Applied $job_count managed job(s); preserved unmanaged entries"
}

main "$@"
